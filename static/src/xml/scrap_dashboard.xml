<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mrp_barcode_scrap.Dashboard">
        <div class="scrap-dashboard o_action o_view_controller" t-att-class="{'scrap-inventory-mode': this.state.inventoryMode}">

            <!-- ============================================================ -->
            <!-- SCANNING MODE                                                -->
            <!-- ============================================================ -->
            <t t-if="this.state.scanning and !this.state.showResult">
                <div class="container-fluid py-3">
                    <!-- Header -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <h2 class="mb-0">
                                    <t t-if="this.state.inventoryMode">
                                        <i class="oi me-2" data-icon="inventory_2"/>
                                        <span>Inventory Count</span>
                                    </t>
                                    <t t-else="">
                                        <i class="oi me-2" data-icon="barcode"/>
                                        <span>Barcode Scrap</span>
                                    </t>
                                </h2>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary fs-6">
                                        <i class="oi me-1" data-icon="format_list_bulleted"/>
                                        <t t-out="this.totalItems"/> items
                                    </span>
                                    <span t-if="!this.state.inventoryMode" class="badge bg-danger fs-6">
                                        <i class="oi me-1" data-icon="payments"/>
                                        <t t-out="this.formatCurrency(this.totalValue)"/>
                                    </span>
                                    <label t-if="this.state.canInventory"
                                           class="scrap-mode-switch form-check form-switch mb-0 ms-2"
                                           title="Inventory count: the scanned quantities become the new stock">
                                        <input class="form-check-input" type="checkbox" role="switch"
                                               t-att-checked="this.state.inventoryMode"
                                               t-on-change="this.onToggleInventory"/>
                                        <span class="form-check-label fw-bold">Inventory</span>
                                    </label>
                                </div>
                            </div>
                            <div t-if="this.state.inventoryMode" class="alert alert-info py-2 mt-2 mb-0 small">
                                <i class="oi me-1" data-icon="info"/>
                                <span>Scan every piece that is really in stock. The scanned quantities add up and become the new stock; products you do not scan stay unchanged.</span>
                            </div>
                        </div>
                    </div>

                    <!-- Barcode Input Area -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="card barcode-input-card">
                                <div class="card-body py-2">
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text bg-primary text-white">
                                            <i class="oi oi-lg" data-icon="barcode"/>
                                        </span>
                                        <input type="text"
                                               class="form-control form-control-lg barcode-field"
                                               t-ref="this.barcodeInput"
                                               t-att-value="this.state.barcode"
                                               t-on-input="this.onBarcodeInput"
                                               t-on-keydown="this.onBarcodeKeydown"
                                               placeholder="Scan or type barcode..."
                                               autocomplete="off"
                                               t-att-disabled="this.state.applying"
                                               autofocus="autofocus"/>
                                        <span class="input-group-text" t-if="this.state.loading">
                                            <i class="oi oi-spin" data-icon="progress_activity"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Product Lines -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header bg-light py-2">
                                    <div class="row fw-bold small text-muted">
                                        <div class="col-1 text-center">#</div>
                                        <div class="col-1"></div>
                                        <div class="col-3">Product</div>
                                        <div class="col-3 text-center">
                                            <t t-if="this.state.inventoryMode">Counted</t>
                                            <t t-else="">Quantity</t>
                                        </div>
                                        <div class="col-1">UoM</div>
                                        <t t-if="this.state.inventoryMode">
                                            <div class="col-1 text-end">In Stock</div>
                                            <div class="col-1 text-end">Difference</div>
                                        </t>
                                        <t t-else="">
                                            <div class="col-1 text-end">Unit Price</div>
                                            <div class="col-1 text-end">Subtotal</div>
                                        </t>
                                        <div class="col-1 text-center">
                                            <i class="oi" data-icon="settings"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    <t t-if="!this.hasLines">
                                        <div class="text-center text-muted py-5">
                                            <i class="oi oi-4x mb-3 d-block opacity-25" data-icon="barcode"/>
                                            <p class="fs-5">Scan a product barcode to begin</p>
                                        </div>
                                    </t>
                                    <t t-foreach="this.state.lines" t-as="line" t-key="line.product_id">
                                        <div class="scrap-line-item border-bottom px-3 py-2"
                                             t-att-class="{'bg-light-yellow': line.barcode_type === 'weight'}">
                                            <div class="row align-items-center">
                                                <div class="col-1 text-center text-muted">
                                                    <t t-out="line_index + 1"/>
                                                </div>
                                                <div class="col-1">
                                                    <img t-att-src="line.image_url"
                                                         class="rounded product-thumb"
                                                         alt="Product"
                                                         loading="lazy"
                                                         onerror="this.style.display='none'"/>
                                                </div>
                                                <div class="col-3">
                                                    <strong><t t-out="line.product_name"/></strong>
                                                    <br/>
                                                    <small class="text-muted">
                                                        <span t-if="line.barcode_type === 'weight'"
                                                              class="badge bg-info text-white me-1">
                                                            <i class="oi me-1" data-icon="balance"/>Weight
                                                        </span>
                                                        <span t-if="line.barcode_type === 'unit'"
                                                              class="badge bg-secondary text-white me-1">
                                                            <i class="oi me-1" data-icon="package_2"/>Pieces
                                                        </span>
                                                    </small>
                                                </div>
                                                <div class="col-3 text-center">
                                                    <div class="d-flex align-items-center justify-content-center gap-1">
                                                        <button class="btn btn-outline-secondary btn-sm qty-btn"
                                                                t-on-click="() => this.decrementQuantity(line_index)">
                                                            <i class="oi" data-icon="remove"/>
                                                        </button>
                                                        <input type="number"
                                                               class="form-control form-control-sm text-center qty-input"
                                                               t-att-value="line.quantity"
                                                               t-on-change="(ev) => this.updateQuantity(line_index, ev)"
                                                               t-att-min="this.state.inventoryMode ? '0' : '0.001'"
                                                               t-att-max="this.state.inventoryMode ? undefined : line.qty_available"
                                                               step="any"/>
                                                        <button class="btn btn-outline-secondary btn-sm qty-btn"
                                                                t-on-click="() => this.incrementQuantity(line_index)">
                                                            <i class="oi" data-icon="add"/>
                                                        </button>
                                                        <button t-if="!this.state.inventoryMode"
                                                                class="btn btn-outline-info btn-sm qty-btn"
                                                                t-on-click="() => this.scrapAllStock(line_index)"
                                                                title="Scrap all in stock">
                                                            <i class="oi" data-icon="select_all"/>
                                                        </button>
                                                    </div>
                                                    <small t-if="!this.state.inventoryMode" class="text-muted">
                                                        In stock: <t t-out="this.formatQuantity(line.qty_available)"/> <t t-out="line.uom"/>
                                                    </small>
                                                </div>
                                                <div class="col-1">
                                                    <span class="text-muted"><t t-out="line.uom"/></span>
                                                </div>
                                                <t t-if="this.state.inventoryMode">
                                                    <div class="col-1 text-end"
                                                         t-att-class="{'text-danger': line.qty_available &lt; 0}">
                                                        <t t-out="this.formatQuantity(line.qty_available)"/>
                                                    </div>
                                                    <div class="col-1 text-end fw-bold" t-att-class="this.differenceClass(this.lineDifference(line))">
                                                        <t t-out="this.formatDifference(this.lineDifference(line))"/>
                                                    </div>
                                                </t>
                                                <t t-else="">
                                                    <div class="col-1 text-end">
                                                        <t t-out="this.formatCurrency(line.unit_price)"/>
                                                    </div>
                                                    <div class="col-1 text-end fw-bold">
                                                        <t t-out="this.formatCurrency(line.quantity * line.unit_price)"/>
                                                    </div>
                                                </t>
                                                <div class="col-1 text-center">
                                                    <button class="btn btn-outline-danger btn-sm"
                                                            t-on-click="() => this.removeLine(line_index)"
                                                            title="Remove">
                                                        <i class="oi" data-icon="delete"/>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Scrap Reason -->
                    <div t-if="!this.state.inventoryMode" class="row mb-3">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-body py-2">
                                    <div class="row align-items-center">
                                        <div class="col-auto">
                                            <label class="form-label fw-bold mb-0">
                                                <i class="oi me-1" data-icon="sell"/>
                                                Scrap Reason:
                                            </label>
                                        </div>
                                        <div class="col">
                                            <select class="form-select"
                                                    t-on-change="this.onReasonTagChange">
                                                <option value="">-- Select a reason --</option>
                                                <t t-foreach="this.state.reasonTags" t-as="tag" t-key="tag.id">
                                                    <option t-att-value="tag.id"
                                                            t-att-selected="tag.id === this.state.scrap_reason_tag_id">
                                                        <t t-out="tag.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Total and Scrap / Apply Inventory Button -->
                    <div class="row">
                        <div class="col-12">
                            <div class="card scrap-footer-card">
                                <div class="card-body py-3">
                                    <div t-if="this.state.inventoryMode" class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div>
                                            <span class="fs-6 text-muted">Value of the difference:</span>
                                            <span class="fs-3 fw-bold ms-2" t-att-class="this.differenceClass(this.inventoryDifferenceValue)">
                                                <t t-out="this.formatCurrency(this.inventoryDifferenceValue)"/>
                                            </span>
                                        </div>
                                        <button class="btn btn-primary btn-lg px-5 inventory-apply-btn"
                                                t-on-click="this.onScrapClick"
                                                t-att-disabled="!this.hasLines || this.state.loading || this.state.applying">
                                            <i class="oi me-2" data-icon="check"/>
                                            <span>Apply Inventory Count</span>
                                            <span class="badge bg-light text-primary ms-2"><t t-out="this.totalItems"/></span>
                                        </button>
                                    </div>
                                    <div t-else="" class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="fs-6 text-muted">Total scrap value:</span>
                                            <span class="fs-3 fw-bold text-danger ms-2">
                                                <t t-out="this.formatCurrency(this.totalValue)"/>
                                            </span>
                                        </div>
                                        <button class="btn btn-danger btn-lg px-5"
                                                t-on-click="this.onScrapClick"
                                                t-att-disabled="!this.hasLines || this.state.loading">
                                            <i class="oi me-2" data-icon="delete"/>
                                            Scrap <t t-out="this.totalItems"/> product(s)
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>

            <!-- ============================================================ -->
            <!-- CONFIRMATION DIALOG (OVERLAY)                                -->
            <!-- ============================================================ -->
            <t t-if="this.state.showConfirmDialog and this.state.inventoryMode">
                <div class="scrap-confirm-overlay">
                    <div class="scrap-confirm-dialog">
                        <div class="card shadow-lg">
                            <div class="card-header bg-primary text-white">
                                <h4 class="mb-0">
                                    <i class="oi me-2" data-icon="inventory_2"/>
                                    <span>Confirm Inventory Count</span>
                                </h4>
                            </div>
                            <div class="card-body">
                                <p class="fs-5">
                                    The stock of these products will be set to the counted quantity:
                                </p>
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th class="text-end">In Stock</th>
                                            <th class="text-end">Counted</th>
                                            <th class="text-end">Difference</th>
                                            <th>UoM</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="this.state.lines" t-as="line" t-key="line.product_id">
                                            <tr>
                                                <td><t t-out="line.product_name"/></td>
                                                <td class="text-end"><t t-out="this.formatQuantity(line.qty_available)"/></td>
                                                <td class="text-end fw-bold"><t t-out="this.formatQuantity(line.quantity)"/></td>
                                                <td class="text-end fw-bold" t-att-class="this.differenceClass(this.lineDifference(line))">
                                                    <t t-out="this.formatDifference(this.lineDifference(line))"/>
                                                </td>
                                                <td><t t-out="line.uom"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                    <tfoot>
                                        <tr class="fw-bold">
                                            <td colspan="3">Value of the difference</td>
                                            <td class="text-end" colspan="2" t-att-class="this.differenceClass(this.inventoryDifferenceValue)">
                                                <t t-out="this.formatCurrency(this.inventoryDifferenceValue)"/>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                                <div class="alert alert-warning">
                                    <i class="oi me-1" data-icon="info"/>
                                    <span>The difference is booked as an inventory adjustment in warehouse</span>
                                    <strong class="ms-1"><t t-out="this.state.warehouseName"/></strong>.
                                    <span>Products you did not scan stay unchanged.</span>
                                </div>
                            </div>
                            <div class="card-footer d-flex justify-content-end gap-2">
                                <button class="btn btn-secondary btn-lg" t-on-click="this.cancelConfirm">
                                    <i class="oi me-1" data-icon="close"/>
                                    Cancel
                                </button>
                                <button class="btn btn-primary btn-lg inventory-confirm-btn" t-on-click="this.confirmScrap">
                                    <i class="oi me-1" data-icon="check"/>
                                    <span>Confirm Inventory Count</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
            <t t-if="this.state.showConfirmDialog and !this.state.inventoryMode">
                <div class="scrap-confirm-overlay">
                    <div class="scrap-confirm-dialog">
                        <div class="card shadow-lg">
                            <div class="card-header bg-danger text-white">
                                <h4 class="mb-0">
                                    <i class="oi me-2" data-icon="warning"/>
                                    Confirm Scrap
                                </h4>
                            </div>
                            <div class="card-body">
                                <p class="fs-5">
                                    Are you sure you want to scrap the following products?
                                </p>
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th class="text-end">Quantity</th>
                                            <th>UoM</th>
                                            <th class="text-end">Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="this.state.lines" t-as="line" t-key="line.product_id">
                                            <tr>
                                                <td><t t-out="line.product_name"/></td>
                                                <td class="text-end"><t t-out="this.formatQuantity(line.quantity)"/></td>
                                                <td><t t-out="line.uom"/></td>
                                                <td class="text-end"><t t-out="this.formatCurrency(line.quantity * line.unit_price)"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                    <tfoot>
                                        <tr class="fw-bold">
                                            <td colspan="3">Total</td>
                                            <td class="text-end text-danger">
                                                <t t-out="this.formatCurrency(this.totalValue)"/>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                                <div class="mb-3">
                                    <strong>Reason:</strong>
                                    <t t-if="this.selectedReasonTagName">
                                        <span class="badge bg-info ms-1"><t t-out="this.selectedReasonTagName"/></span>
                                    </t>
                                    <t t-else="">
                                        <span class="text-muted">N/A</span>
                                    </t>
                                </div>
                                <div class="alert alert-warning">
                                    <i class="oi me-1" data-icon="info"/>
                                    <span>Products to scrap right away (one scrap per product, Inventory › Operations › Adjustments › Scrap):</span>
                                    <strong class="ms-1"><t t-out="this.totalItems"/></strong>
                                    <div class="mt-1"><span>This action</span> <strong>cannot be undone</strong>.</div>
                                </div>
                            </div>
                            <div class="card-footer d-flex justify-content-end gap-2">
                                <button class="btn btn-secondary btn-lg" t-on-click="this.cancelConfirm">
                                    <i class="oi me-1" data-icon="close"/>
                                    Cancel
                                </button>
                                <button class="btn btn-danger btn-lg" t-on-click="this.confirmScrap">
                                    <i class="oi me-1" data-icon="check"/>
                                    Confirm Scrap
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </t>

            <!-- ============================================================ -->
            <!-- RESULT SCREEN (After Inventory Count)                        -->
            <!-- ============================================================ -->
            <t t-if="this.state.showResult and this.state.inventoryResult">
                <div class="container-fluid py-3">
                    <div class="row mb-4">
                        <div class="col-12 text-center">
                            <div class="scrap-success-icon mb-3">
                                <i class="oi text-success oi-5x" data-icon="check_circle"/>
                            </div>
                            <h2 class="text-success">Inventory Count Applied</h2>
                            <p class="text-muted fs-5">
                                <span>Stock changed for products:</span>
                                <strong class="ms-1"><t t-out="this.state.inventoryResult.changed_count"/></strong>
                            </p>
                            <div t-if="this.state.inventoryResult.skipped.length" class="alert alert-warning d-inline-block">
                                <span>Skipped (they do not track stock):</span>
                                <span class="ms-1"><t t-out="this.state.inventoryResult.skipped.join(', ')"/></span>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card border-info">
                                <div class="card-header bg-info text-white">
                                    <h5 class="mb-0">
                                        <i class="oi me-2" data-icon="inventory_2"/>
                                        <span>Stock After the Inventory Count</span>
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    <table class="table table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>Product</th>
                                                <th class="text-end">Before</th>
                                                <th class="text-end">After</th>
                                                <th class="text-end">Difference</th>
                                                <th>UoM</th>
                                                <th class="text-center">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="this.state.inventoryResult.lines" t-as="res" t-key="res.product_id">
                                                <tr class="inventory-result-row">
                                                    <td><strong><t t-out="res.product_name"/></strong></td>
                                                    <td class="text-end" t-att-class="{'text-danger': res.qty_before &lt; 0}">
                                                        <t t-out="this.formatQuantity(res.qty_before)"/>
                                                    </td>
                                                    <td class="text-end fw-bold"><t t-out="this.formatQuantity(res.qty_after)"/></td>
                                                    <td class="text-end fw-bold" t-att-class="this.differenceClass(res.difference)">
                                                        <t t-out="this.formatDifference(res.difference)"/>
                                                    </td>
                                                    <td><t t-out="res.uom"/></td>
                                                    <td class="text-center">
                                                        <button class="btn btn-outline-primary btn-sm me-1"
                                                                t-on-click="() => this.openProductForm(res.product_id)"
                                                                title="Open Product">
                                                            <i class="oi me-1" data-icon="open_in_new"/>
                                                            Product
                                                        </button>
                                                        <button class="btn btn-outline-warning btn-sm"
                                                                t-on-click="() => this.openInventoryAdjustment(res.product_id)"
                                                                title="Adjust Stock">
                                                            <i class="oi me-1" data-icon="edit"/>
                                                            Update Stock
                                                        </button>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 text-center">
                            <button class="btn btn-primary btn-lg px-5" t-on-click="this.startNewSession">
                                <i class="oi me-2" data-icon="refresh"/>
                                <span>Start New Inventory Count</span>
                            </button>
                        </div>
                    </div>
                </div>
            </t>

            <!-- ============================================================ -->
            <!-- RESULT SCREEN (After Scrap)                                  -->
            <!-- ============================================================ -->
            <t t-if="this.state.showResult and this.state.scrapResult">
                <div class="container-fluid py-3">
                    <!-- Header -->
                    <div class="row mb-4">
                        <div class="col-12 text-center">
                            <div class="scrap-success-icon mb-3">
                                <i class="oi text-success oi-5x" data-icon="check_circle"/>
                            </div>
                            <h2 class="text-success">Scrap Completed Successfully</h2>
                            <p class="text-muted fs-5">
                                <span>Scrapped products:</span>
                                <strong class="ms-1"><t t-out="this.state.scrapResult.scrap_count"/></strong>
                            </p>
                            <div t-if="this.state.scrapResult.skipped.length" class="alert alert-warning d-inline-block">
                                <span>Skipped (no stock):</span>
                                <span class="ms-1"><t t-out="this.state.scrapResult.skipped.join(', ')"/></span>
                            </div>
                        </div>
                    </div>

                    <!-- Scrapped Items -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">
                                        <i class="oi me-2" data-icon="format_list_bulleted"/>
                                        Scrapped Items
                                    </h5>
                                    <button t-if="this.state.scrapResult.scraps.length"
                                            class="btn btn-outline-primary btn-sm scrap-open-all-btn"
                                            t-on-click="() => this.openScraps(this.state.scrapResult.scraps.map((s) => s.id))">
                                        <i class="oi me-1" data-icon="open_in_new"/>
                                        <span>Open Scraps</span>
                                    </button>
                                </div>
                                <div class="card-body p-0">
                                    <table class="table table-striped mb-0">
                                        <thead>
                                            <tr>
                                                <th>Reference</th>
                                                <th>Product</th>
                                                <th class="text-end">Quantity</th>
                                                <th>UoM</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="this.state.scrapResult.scraps" t-as="scrap" t-key="scrap.id">
                                                <tr>
                                                    <td>
                                                        <a href="#" class="badge bg-primary text-white text-decoration-none scrap-open-link"
                                                           t-on-click.prevent="() => this.openScraps([scrap.id])">
                                                            <i class="oi me-1" data-icon="open_in_new"/>
                                                            <t t-out="scrap.name"/>
                                                        </a>
                                                    </td>
                                                    <td><t t-out="scrap.product_name"/></td>
                                                    <td class="text-end">
                                                        <t t-out="this.formatQuantity(scrap.quantity)"/>
                                                        <span t-if="scrap.capped" class="badge bg-warning text-dark ms-1"
                                                              title="Less than scanned: capped at the stock">capped</span>
                                                    </td>
                                                    <td><t t-out="scrap.uom"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Current Stock Levels -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card border-info">
                                <div class="card-header bg-info text-white">
                                    <h5 class="mb-0">
                                        <i class="oi me-2" data-icon="inventory_2"/>
                                        Current Stock Levels (After Scrap)
                                    </h5>
                                </div>
                                <div class="card-body p-0">
                                    <table class="table table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>Product</th>
                                                <th class="text-end">Current Stock</th>
                                                <th>UoM</th>
                                                <th class="text-end">Stock Value</th>
                                                <th class="text-center">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="Object.values(this.state.scrapResult.stock_after)" t-as="stock" t-key="stock.product_id">
                                                <tr>
                                                    <td><strong><t t-out="stock.product_name"/></strong></td>
                                                    <td class="text-end"
                                                        t-att-class="{'text-danger fw-bold': stock.qty_available &lt;= 0}">
                                                        <t t-out="this.formatQuantity(stock.qty_available)"/>
                                                    </td>
                                                    <td><t t-out="stock.uom"/></td>
                                                    <td class="text-end">
                                                        <t t-out="this.formatCurrency(stock.value)"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <button class="btn btn-outline-primary btn-sm me-1"
                                                                t-on-click="() => this.openProductForm(stock.product_id)"
                                                                title="Open Product">
                                                            <i class="oi me-1" data-icon="open_in_new"/>
                                                            Product
                                                        </button>
                                                        <button t-if="this.state.canInventory"
                                                                class="btn btn-outline-warning btn-sm"
                                                                t-on-click="() => this.openInventoryAdjustment(stock.product_id)"
                                                                title="Adjust Stock">
                                                            <i class="oi me-1" data-icon="edit"/>
                                                            Update Stock
                                                        </button>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- New Session Button -->
                    <div class="row">
                        <div class="col-12 text-center">
                            <button class="btn btn-primary btn-lg px-5"
                                    t-on-click="this.startNewSession">
                                <i class="oi me-2" data-icon="refresh"/>
                                Start New Scrap Session
                            </button>
                        </div>
                    </div>
                </div>
            </t>

            <!-- ============================================================ -->
            <!-- LOADING OVERLAY                                              -->
            <!-- ============================================================ -->
            <t t-if="this.state.loading and !this.state.scanning">
                <div class="scrap-loading-overlay">
                    <div class="text-center text-white">
                        <i class="oi oi-spin oi-4x mb-3" data-icon="progress_activity"/>
                        <p class="fs-4">Scrapping...</p>
                    </div>
                </div>
            </t>
            <t t-if="this.state.applying">
                <div class="scrap-loading-overlay inventory-applying-overlay">
                    <div class="text-center text-white">
                        <i class="oi oi-spin oi-4x mb-3" data-icon="progress_activity"/>
                        <p class="fs-4">Saving the inventory count...</p>
                    </div>
                </div>
            </t>

        </div>
    </t>
</templates>

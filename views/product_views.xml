<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Update Stock / Set Stock to Zero on the product form. The product.product form
         (product_normal_form_view) is built from this template form, so the buttons show
         there too and call the product.product methods. -->
    <record id="product_template_form_view_quick_stock" model="ir.ui.view">
        <field name="name">product.template.form.quick.stock</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet[@name='product_form']" position="before">
                <header>
                    <button name="action_quick_stock_update" type="object" string="Update Stock"
                            class="btn-primary" icon="edit"
                            invisible="not is_storable or not id" groups="stock.group_stock_manager"/>
                    <button name="action_quick_stock_zero" type="object" string="Set Stock to Zero"
                            class="btn-secondary" icon="block"
                            invisible="not is_storable or not id" groups="stock.group_stock_manager"
                            confirm="Set the on-hand quantity of this product (all its variants) to 0?"/>
                </header>
            </xpath>
        </field>
    </record>

    <!-- List action (Actions menu after selecting products): dialog with the selected products, new stock 0 -->
    <record id="action_product_template_quick_stock_zero" model="ir.actions.server">
        <field name="name">Set Stock to Zero</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="group_ids" eval="[(4, ref('stock.group_stock_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_quick_stock_zero_bulk()</field>
    </record>

    <record id="action_product_product_quick_stock_zero" model="ir.actions.server">
        <field name="name">Set Stock to Zero</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="group_ids" eval="[(4, ref('stock.group_stock_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_quick_stock_zero_bulk()</field>
    </record>

    <!--
        Negative Stock: storable products (archived included) with negative stock in the main
        warehouse. Opened by the menu Inventory › Operations › Adjustments › Negative Stock and the
        button on the barcode dashboard (inventory mode). The list only shows the products; Set Stock
        to Zero in the header (after selecting products) opens the preview dialog that applies it.
        Priority 100: not the default list of product.product.
    -->
    <record id="product_product_negative_stock_list" model="ir.ui.view">
        <field name="name">product.product.negative.stock.list</field>
        <field name="model">product.product</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Negative Stock" create="0" delete="0" decoration-muted="not active">
                <header>
                    <button name="action_quick_stock_zero_bulk" type="object" string="Set Stock to Zero"
                            class="btn-primary" icon="block"/>
                </header>
                <field name="active" column_invisible="1"/>
                <field name="default_code" optional="show"/>
                <field name="name"/>
                <field name="product_template_variant_value_ids" widget="many2many_tags"
                       groups="product.group_product_variant" optional="show"/>
                <field name="categ_id" optional="show"/>
                <field name="qty_available" string="On Hand" decoration-danger="qty_available &lt; 0"/>
                <field name="uom_id" groups="uom.group_uom" optional="show"/>
                <field name="standard_price" optional="hide"/>
                <field name="lst_price" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_negative_stock" model="ir.actions.server">
        <field name="name">Negative Stock</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="group_ids" eval="[(4, ref('stock.group_stock_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = model.action_negative_stock_list()</field>
    </record>

    <!-- The product.product form gets the template header above; there the zero button
         only changes that one variant, so the question must say so. Odoo 20 opens variants
         (Variants button of the template) in this form too, product_variant_easy_edit_view is gone. -->
    <record id="product_normal_form_view_quick_stock" model="ir.ui.view">
        <field name="name">product.product.form.quick.stock</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_quick_stock_zero']" position="attributes">
                <attribute name="confirm">Set the on-hand quantity of this variant to 0?</attribute>
            </xpath>
        </field>
    </record>
</odoo>
